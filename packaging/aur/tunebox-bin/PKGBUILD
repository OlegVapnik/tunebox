# Made for each release from packaging/aur/tunebox-bin/PKGBUILD in https://github.com/OlegVapnik/tunebox.
# Maintainer: OlegVapnik <36790116+OlegVapnik@users.noreply.github.com>

# The Spotify build. tunebox-ytmusic-bin has YouTube Music instead, tunebox-full-bin both.
pkgname=tunebox-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Spotify client for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/OlegVapnik/tunebox'
license=('MIT')
depends=('alsa-lib' 'glibc' 'libgcc' 'libpulse')
provides=("tunebox=$pkgver")
conflicts=('tunebox')
# The release build comes stripped, so there is nothing for a debug package either.
options=('!strip' '!debug')
source_x86_64=("tunebox-spotify-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/tunebox-spotify-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("tunebox-spotify-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/tunebox-spotify-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA256_SPOTIFY_X86_64_UNKNOWN_LINUX_GNU@')
sha256sums_aarch64=('@SHA256_SPOTIFY_AARCH64_UNKNOWN_LINUX_GNU@')

package() {
  install -Dm755 tunebox "$pkgdir/usr/bin/tunebox"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
