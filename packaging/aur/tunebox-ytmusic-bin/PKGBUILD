# Made for each release from packaging/aur/tunebox-ytmusic-bin/PKGBUILD in https://github.com/OlegVapnik/tunebox.
# Maintainer: OlegVapnik <36790116+OlegVapnik@users.noreply.github.com>

# The YouTube Music build, without Spotify. mpv plays, yt-dlp finds the streams, deno
# solves YouTube's challenges for yt-dlp, and python-secretstorage lets it read the keyring
# of Chromium-based browsers for the sign-in.
pkgname=tunebox-ytmusic-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='YouTube Music client for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/OlegVapnik/tunebox'
license=('MIT')
depends=('deno' 'glibc' 'libgcc' 'mpv' 'python-secretstorage' 'yt-dlp')
provides=("tunebox=$pkgver")
conflicts=('tunebox')
# The release build comes stripped, so there is nothing for a debug package either.
options=('!strip' '!debug')
source_x86_64=("tunebox-ytmusic-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/tunebox-ytmusic-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("tunebox-ytmusic-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/tunebox-ytmusic-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA256_YTMUSIC_X86_64_UNKNOWN_LINUX_GNU@')
sha256sums_aarch64=('@SHA256_YTMUSIC_AARCH64_UNKNOWN_LINUX_GNU@')

package() {
  install -Dm755 tunebox "$pkgdir/usr/bin/tunebox"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
